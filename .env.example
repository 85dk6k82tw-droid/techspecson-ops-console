# TSO Ops secure foundation
# Copy to a local .env file. Never commit real credentials.

APP_ENV=development
SESSION_SECRET=replace-with-secret-from-deployment-secret-store
SESSION_COOKIE_NAME=tso_ops_session
SESSION_TTL_MINUTES=60

# Future identity-provider configuration
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_CALLBACK_URL=

# Never place PayPal, DAD, customer, or SB secrets in browser code.
